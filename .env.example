# Postgres connection string for the enquiry + content database
DATABASE_URL=

# Optional: the database server's CA certificate (PEM). When set, the TLS certificate is verified.
# Paste the whole certificate; newlines may be written as \n.
DATABASE_CA=

# First admin account, created on the first server start
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Random string used to sign the admin login cookie
SESSION_SECRET=
