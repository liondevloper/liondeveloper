# Postgres connection string for the enquiry + content database
DATABASE_URL=

# First admin account, created on the first server start
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Random string used to sign the admin login cookie
SESSION_SECRET=

# --- Payments platform (/pay) ---------------------------------------------
# Signs merchant sessions. Leave blank to derive it from SESSION_SECRET.
PAY_SESSION_SECRET=

# Hyperswitch hosted sandbox: https://sandbox.hyperswitch.io
# Create the key at app.hyperswitch.io under Developers then Keys, in test mode.
HYPERSWITCH_SANDBOX_API_KEY=
HYPERSWITCH_SANDBOX_PROFILE_ID=
HYPERSWITCH_SANDBOX_RESPONSE_HASH_KEY=

# Hyperswitch live: https://api.hyperswitch.io
# Both of these plus PAY_LIVE_MODE_ENABLED=true are required before any real money moves.
HYPERSWITCH_LIVE_API_KEY=
HYPERSWITCH_LIVE_PROFILE_ID=
HYPERSWITCH_LIVE_RESPONSE_HASH_KEY=
PAY_LIVE_MODE_ENABLED=
